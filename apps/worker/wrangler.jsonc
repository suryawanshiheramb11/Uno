{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uno-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Top level = local dev (`wrangler dev`). Environments do NOT inherit bindings, so each is explicit.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* hits the Worker first; everything else is served straight from the asset layer.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "PRESENCE", "class_name": "Presence" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker", "Presence"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations",
      "database_name": "uno-local",
      "database_id": "local-placeholder",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "APP_URL": "http://localhost:8787",
    "PROTOCOL_VERSION": "1",
    "GIT_SHA": "dev",
  },

  "env": {
    "staging": {
      "name": "uno-staging",
      "routes": [{ "pattern": "staging.uno.example.com", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
          { "name": "PRESENCE", "class_name": "Presence" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker", "Presence"] }],
      // TODO: replace with the id printed by `wrangler d1 create uno-staging`.
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "migrations",
          "database_name": "uno-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_URL": "https://staging.uno.example.com",
        "PROTOCOL_VERSION": "1",
        "GIT_SHA": "dev",
      },
    },
    "production": {
      "name": "uno-prod",
      "routes": [{ "pattern": "uno.example.com", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
          { "name": "PRESENCE", "class_name": "Presence" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker", "Presence"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "migrations",
          "database_name": "uno-prod",
          "database_id": "REPLACE_WITH_PROD_D1_ID",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://uno.example.com",
        "PROTOCOL_VERSION": "1",
        "GIT_SHA": "dev",
      },
    },
  },
}
