{
  "name": "uno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w apps/web && npm run build -w apps/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "deploy:staging": "npm run build && npm run deploy:staging -w apps/worker",
    "check:contract": "bash scripts/check-contract.sh",
    "demo:classic": "npm run demo:classic -w packages/engine --"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "prettier": "^3.6.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "@playwright/test": "^1.55.0"
  }
}
